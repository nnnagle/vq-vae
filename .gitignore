# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
.venv/
venv/
env/

# OS
.DS_Store

# R 
*.Rproj
.Rproj.user

# Python package build
build/
dist/
*.egg-info/

# Jupyter notebooks
.ipynb_checkpoints/

# Data / Models
data/
runs/
models/
out/
.claude/

# `frl/models` is a source package, not a weights dir — keep its sources tracked
# (without overriding the __pycache__ / *.pyc rules above).
!frl/models/
!frl/models/**/*.py
!frl/models/**/*.md
